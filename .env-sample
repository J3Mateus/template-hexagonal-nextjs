# API Backend
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Auth.js v5 Configuration
AUTH_SECRET=<gere-com-npx-auth-secret>
AUTH_URL=http://localhost:3000

# Keycloak Configuration (Auth.js v5)
KEYCLOAK_REALM=sebrae
KEYCLOAK_URL=http://localhost:8080
AUTH_KEYCLOAK_ID=template
AUTH_KEYCLOAK_SECRET=<client-secret-do-keycloak>
AUTH_KEYCLOAK_ISSUER=${KEYCLOAK_URL}/realms/${KEYCLOAK_REALM}

# Keycloak Admin (opcional)
KEYCLOAK_BASE_URL_ADMIN=${KEYCLOAK_URL}/admin/realms/${KEYCLOAK_REALM}/users

# Docker Configuration
DOCKER_PROJECT_NAME=[PROJECT-NAME]
DOCKER_NGINX_PORT=3000
DOCKER_NGINX_PORT_SSL=
DOCKER_SCHEME=
DOCKER_FRONTEND_HOST=
DOCKER_EXTRA_HOSTS=$DOCKER_FRONTEND_HOST:172.17.0.1
DOCKER_VOLUME_APP=.
DOCKER_VOLUME_DOCKER=./docker
