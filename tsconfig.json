{
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@api/*": [
        "./src/@code/infra/api/*"
      ],
      "@models/*": [
        "./src/@code/core/domain/models/*"
      ],
      "@typing/*": [
        "./src/@code/core/domain/types/*"
      ],
      "@language/*": [
        "./src/@code/core/language/*"
      ],
      "@interfaces/*": [
        "./src/@code/core/interfaces/*"
      ],
      "@services/*": [
        "./src/@code/core/services/*"
      ],
      "@web/*": [
        "./src/@code/*"
      ],
      "@cache/*": [
        "./src/@code/core/cache/*"
      ]
    },
    "target": "ES2017"
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
